rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/editorAccess/$(request.auth.token.email));
    }

    function isAdmin() {
      return isAllowedEditor()
        && get(/databases/$(database)/documents/editorAccess/$(request.auth.token.email)).data.role == 'admin';
    }

    match /editorAccess/{email} {
      allow read: if isAdmin() || (request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'addedAt', 'addedBy'])
        && request.resource.data.role == 'editor';
      allow update: if isAdmin()
        && resource.data.role == 'editor'
        && request.resource.data.keys().hasOnly(['role', 'addedAt', 'addedBy'])
        && request.resource.data.role == 'editor';
      allow delete: if isAdmin() && resource.data.role == 'editor';
    }

    match /ripples/{document=**} {
      allow read, write: if isAllowedEditor();
    }

    match /proposals/{document=**} {
      allow read, write: if isAllowedEditor();
    }

    match /editorialRules/{document=**} {
      allow read, write: if isAllowedEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
